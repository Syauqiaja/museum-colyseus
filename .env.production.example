# Copy to `.env.production` on the VPS and fill in real values.
# `.env.production` is gitignored — it must never be committed.
#
# @colyseus/tools loads `.env.${NODE_ENV}` at boot, and ecosystem.config.cjs
# sets NODE_ENV=production, so this file is what the PM2 process reads.

# --- HTTP -------------------------------------------------------------------
# Nginx proxies to this port on 127.0.0.1. Do not open it in the firewall.
PORT=2567

# --- MySQL ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=museum
DB_PASSWORD=
DB_NAME=museum_minigames
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=5000

# Set to 1 to run with persistence disabled (no MySQL required).
DB_DISABLED=0

# --- Ops --------------------------------------------------------------------
# Set to 1 to expose the /monitor room panel. Leave unset in normal operation;
# when enabled, Nginx basic auth in front of it is mandatory.
MONITOR_ENABLED=
