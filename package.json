{
  "private": true,
  "name": "museum-minigames",
  "version": "0.1.0",
  "description": "Colyseus backend for museum WebGL minigames (Dakon, Engklak, Egrang)",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "db:migrate": "tsx db/migrate.ts",
    "loadtest": "tsx loadtest/example.ts --room dakon --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "DB_DISABLED=1 mocha -r tsx --require test/support/server.ts test/*.test.ts --exit --timeout 30000",
    "test:db": "mocha -r tsx --require test/support/server.ts test/db/*.test.ts --exit --timeout 30000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.0",
    "@colyseus/tools": "^0.17.0",
    "colyseus": "^0.17.6",
    "express": "^4.18.2",
    "mysql2": "^3.23.3"
  }
}
